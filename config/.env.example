# Application
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false

# Upload limits (file content size; request limit allows multipart overhead)
MAX_FILE_SIZE_MB=100

# Storage
STORAGE_DIR=./storage/files
TEMP_DIR=./storage/temp

# Metadata repository: json (sqlite reserved for future)
METADATA_BACKEND=json
METADATA_FILE=./data/file_metadata.json

# Encryption
# Set ENCRYPTION_ENABLED=false to reject encrypt=true uploads.
ENCRYPTION_ENABLED=true
# 32-byte AES-256 key encoded as 64 hex characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
